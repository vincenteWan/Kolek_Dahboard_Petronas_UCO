function populateApplicantTableFromData(data) {
    const tbody = document.querySelector('.applicant-table tbody');
    if (!tbody) return;
    const rows = data.map(d => {
        const id = d.applicationID || d.applicationId || '';
        const name = d.applicantName || d.name || '';
        const phone = d.phoneNumber || d.phone || '';
        const email = d.emailAddress || d.email || '';
        const vehicle = d.vehicleType || '';
        const plate = d.vehiclePlateNumber || '';
        const area = d.preferredCollectionArea || '';
        const status = d.applicationStatus || d.status || '';
        const statusClass = String(status).toLowerCase().includes('approve') ? 'success' : 
                           String(status).toLowerCase().includes('reject') ? 'danger' : 'warning';
        const action = String(status).toLowerCase().includes('pending') 
            ? `<a href="#" class="success-action">[Approve]</a> <a href="#" class="danger-action">[Reject]</a>`
            : `<a href="#" class="note">[View]</a>`;
        return `
            <tr>
                <td>${escapeHtml('#' + id)}</td>
                <td>${escapeHtml(name)}</td>
                <td>${escapeHtml(phone)}</td>
                <td>${escapeHtml(email)}</td>
                <td>${escapeHtml(vehicle)}</td>
                <td>${escapeHtml(plate)}</td>
                <td>${escapeHtml(area)}</td>
                <td><span class="${statusClass}">${escapeHtml(status)}</span></td>
                <td class="actions-col">${action}</td>
            </tr>
        `;
    }).join('\n');
    tbody.innerHTML = rows;
}

